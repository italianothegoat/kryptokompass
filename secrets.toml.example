# Was macht diese Datei?
# Sie ist eine VORLAGE für eure echte Geheimnis-Datei.
# So geht's:
#   1. Diese Datei kopieren und die Kopie "secrets.toml" nennen (gleicher Ordner).
#   2. In der Kopie eure echten Werte eintragen.
#   3. Die echte secrets.toml wird durch .gitignore NICHT hochgeladen – sie bleibt bei euch.
# Auf Render tragt ihr dieselben Namen und Werte unter "Environment" ein (ohne Anführungszeichen).

# Euer kostenloser Demo-API-Key von CoinGecko (beginnt meist mit "CG-")
COINGECKO_API_KEY = "CG-hier-euren-key-eintragen"

# Geheimer Schlüssel für die Login-Sitzungen (eine lange, zufällige Zeichenfolge).
# Lokal optional – ohne Eintrag nimmt die Website einen Test-Schlüssel.
# Auf Render PFLICHT: dort beim Eintragen auf "Generate" klicken.
SECRET_KEY = ""

# Adresse der Online-Datenbank für die Benutzerkonten (von Neon, beginnt mit "postgresql://").
# Lokal LEER lassen – dann werden die Konten in data/users.db gespeichert.
DATABASE_URL = ""
